# Keep the build context small and never ship secrets or local state into an image.

.git
.github

# Rebuilt inside the image; copying them in would also break npm ci's platform
# assumptions.
client/node_modules
client/dist
client/.vite
client/*.tsbuildinfo
node_modules

# The browser SDK is not part of the image — it is consumed by other front ends.
# A bare `node_modules` pattern only matches the root one, so these need naming.
sdk/node_modules
sdk/dist

# WhatsApp session credentials and recordings — these belong in the /data volume,
# never baked into a layer.
*.db
*.db-journal
*.db-wal
*.db-shm
gravacoes/
recordings/
/auth/
/data/

# Local build output
*.exe
/dist/
/bin/
.gotmp/
coverage.*
*.prof
*.pcap
*.pcapng
*.keys

# Docs and editor noise
*.md
!README.md
.vscode/
.idea/
.DS_Store
Thumbs.db
